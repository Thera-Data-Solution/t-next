// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DzikirCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  icon        String?
  groups      Dzikir[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Dzikir {
  id    String @id @default(cuid())
  title String
  order Int

  categoryId String
  category   DzikirCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  items DzikirItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DzikirItem {
  id              String  @id @default(cuid())
  arabic          String
  transliteration String?
  translation     String?
  count           Int     @default(1)
  order           Int

  dzikirId String
  dzikir   Dzikir @relation(fields: [dzikirId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          RoleList  @default(User)
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Ustadzh {
  id            String         @id @default(cuid())
  nama          String
  bio           String?
  jadwalKajians JadwalKajian[] @relation("UstadzhToKajian")
}

model JadwalKajian {
  id          String    @id @default(cuid())
  ustadzhList Ustadzh[] @relation("UstadzhToKajian")

  waktuMulai   DateTime
  waktuSelesai DateTime

  kajianJudul String
  KajianGenre Genre  @default(All)
  KajianUmur  Umur   @default(All)

  lokasiOffline    String?
  linkLokasiOnline String?
  lokasiOnline     String?

  gambar String?

  sumber String?

  createdAt DateTime @default(now())
  createdBy String
  updatedAt DateTime @updatedAt
  updatedBy String
}

enum RoleList {
  Admin
  Moderator
  User
}

enum Genre {
  All
  Ikhwan
  Akhwat
}

enum Umur {
  All
  Dewasa
  Anak
}
